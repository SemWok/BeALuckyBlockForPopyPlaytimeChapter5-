-- Hooking metatable buat ganti teks secara instan sebelum render
local oldIndex
oldIndex = hookmetamethod(game, "__newindex", function(self, index, value)
    if tostring(index) == "Text" then
        if tostring(value):find("Rilz Hub") or tostring(value):find("Credit") then
            value = "YOUTUBE: SemWok"
        end
    end
    return oldIndex(self, index, value)
end)

